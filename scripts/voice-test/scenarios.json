   "expect": ["\\[Route\\] timer \\(start\\(seconds: 600"]},
  {"name": "timer-kalan", "smoke": true, "say": "Zamanlayıcı ne kadar kaldı?",
   "expect": ["\\[Route\\] timer \\(remaining\\)"]},
  {"name": "timer-iptal", "say": "Zamanlayıcıyı iptal et",
   "expect": ["\\[Route\\] timer \\(cancel\\(all: false\\)\\)"]},

  {"name": "video-durdur", "say": "Videoyu durdur",
   "expect": ["\\[Route\\] system \\(video\\(.*pause\\)\\)"]},
  {"name": "video-basa-sar", "say": "Videoyu başa sar",
   "expect": ["\\[Route\\] system \\(video\\(.*restart\\)\\)"]},
  {"name": "video-ileri-sar", "say": "Otuz saniye ileri sar",
   "expect": ["\\[Route\\] system \\(video\\(.*seekBy\\(30\\)\\)\\)"]},
  {"name": "video-hiz", "say": "Video hızını 1.5 yap",
   "expect": ["\\[Route\\] system \\(video\\(.*speed\\(1\\.5\\)\\)\\)"]},

  {"name": "dikte-toplanti", "say": "Toplantı yarın saat üçte",

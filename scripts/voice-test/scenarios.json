   "forbid": ["\\[Route\\] spotify"]},
  {"name": "dikte-yaz-sonu", "say": "Saat kaç yaz",
   "expect": ["\\[VoiceTest\\] would type"],
   "forbid": ["\\[Route\\] system"],

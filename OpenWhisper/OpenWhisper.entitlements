<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    <!-- Hardened runtime denies these silently without the entitlement: Jarvis never even
         appeared under Privacy › Calendars. Calendars also covers Reminders. -->
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
    <key>com.apple.security.device.bluetooth</key>
    <true/>
    <!-- The app bundles DeepFilterNet's vendored libdf.dylib. Local ad-hoc builds have no
         Team ID to satisfy Hardened Runtime library validation, so permit the bundled dylib. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
